# 技術仕様書 §12。値は入れず、変数名のみを置く。
# 生成例: openssl rand -base64 32

# アプリ
NODE_ENV=development
APP_URL=http://localhost:3000
SESSION_SECRET=            # 32バイト以上
ENCRYPTION_KEY=            # integration の暗号化用。32バイト

# DB
DATABASE_URL=postgres://atlasquarry:CHANGE_ME@localhost:5432/atlasquarry
POSTGRES_USER=atlasquarry
POSTGRES_PASSWORD=
POSTGRES_DB=atlasquarry

# シード（scripts/seed.ts が参照。本番投入後は削除してよい）
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_MANAGER_EMAIL=
SEED_MANAGER_PASSWORD=
SEED_DEVELOPER_EMAIL=
SEED_DEVELOPER_PASSWORD=

# 以下は v0.2 以降で使用する。v0.1 では未設定でよい。
# Discord
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=

# メール
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ストレージ
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/var/atlasquarry/attachments

# ログイン画面からの自己登録に要る合言葉。
# **公開URLで動いているので、これが無いと誰でもアカウントを作れてしまう。**
# 32文字以上のランダム値にする。空のままだと自己登録は常に失敗する（＝実質無効）。
# 登録できるのは requester（要望を出すだけ）。権限は設定画面から上げる。
REGISTRATION_CODE=

# 溜まった通知を送る cron から叩くときの鍵。
# `POST /api/v1/notifications/drain` に `x-cron-key` で渡す。
# 空だと常に拒否する（＝通知の配送が止まる）。
CRON_KEY=
