# 技術仕様書 §12。値は入れず、変数名のみを置く。
# 生成例: openssl rand -base64 32

# アプリ
NODE_ENV=development
APP_URL=http://localhost:3000
SESSION_SECRET=            # 32バイト以上
ENCRYPTION_KEY=            # integration の暗号化用。32バイト

# DB
DATABASE_URL=postgres://atlasquarry:CHANGE_ME@localhost:5432/atlasquarry
POSTGRES_USER=atlasquarry
POSTGRES_PASSWORD=
POSTGRES_DB=atlasquarry

# シード（scripts/seed.ts が参照。本番投入後は削除してよい）
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_MANAGER_EMAIL=
SEED_MANAGER_PASSWORD=
SEED_DEVELOPER_EMAIL=
SEED_DEVELOPER_PASSWORD=

# 以下は v0.2 以降で使用する。v0.1 では未設定でよい。
# Discord
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=

# メール
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ストレージ
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/var/atlasquarry/attachments
